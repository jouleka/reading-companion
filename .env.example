# Copy this file to `.env`. The copy is ignored by Git.
# The offline stub is deterministic and makes the local UI usable without sending content to a provider.
ALLOW_STUB=true
DATA_DIR=data
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# To use a provider, uncomment the relevant values and set ALLOW_STUB=false.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=
# EMBED_PROVIDER=openai-compatible
# EMBED_API_KEY=
# EMBED_BASE_URL=
# LLM_CHEAP_MODEL=gpt-4o-mini
# LLM_LARGE_MODEL=gpt-4o
# EMBED_MODEL=text-embedding-3-small

# Hosted mode is experimental and requires the full validated configuration documented in
# backend/app/config.py. Never reuse local/development credentials for a hosted deployment.
