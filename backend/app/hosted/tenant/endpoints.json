  "background": [
    {
      "resource": "worker-claim-and-mutations",
      "operations": ["claim", "start", "heartbeat", "reserve-spend", "commit", "fail", "succeed"],
      "cross_tenant_test": "test_worker_claim_is_owner_and_book_fenced_against_foreign_identifiers"
    },
    {
      "resource": "worker-credential-resolution",
      "operations": ["resolve-credential"],
      "cross_tenant_test": "test_worker_resolves_only_claim_bound_owner_credential_just_in_time"
    },
    {
      "resource": "filesystem-source-storage",
      "operations": ["put", "get", "exists", "delete"],
      "cross_tenant_test": "test_encrypted_filesystem_contract_is_owner_scoped_bounded_and_authenticated"
    },
    {
      "resource": "s3-source-storage",
      "operations": ["put", "get", "exists", "delete"],
      "cross_tenant_test": "test_s3_contract_derives_owner_path_and_enforces_checksum_content_type_and_sse"
    },
    {
      "resource": "runtime-cache-and-locks",
      "operations": ["cache", "serialize"],
      "cross_tenant_test": "test_same_owner_book_serializes_but_same_uuid_for_another_owner_does_not"
    }
  ],
  "unavailable": [
    {
      "method": "GET",
      "path": "/api/books/{book_id}/export",
      "surface": "export",
      "access": "export",
      "expected_status": 404,
      "owner": "LIT-50",
      "reason": "Hosted account/book export requires the audited migration/export workflow.",
      "cross_tenant_test": "test_unavailable_cross_tenant_surfaces_are_non_disclosing"
    }
  ]
